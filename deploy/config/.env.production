# ============================================================
# CACCH AI 平台 - 生产环境配置模板
# 部署脚本会将其拷贝为 /home/aidoc/cacch-ai-platform/.env
# 拷贝后请务必修改：API_AUTH_TOKEN / AUTH_TOKEN_SECRET / LLM_API_KEY
# ============================================================

# --- 安全（部署后必须修改为强随机值）---
# 生成方法：openssl rand -hex 32
API_AUTH_TOKEN=please-change-me
AUTH_TOKEN_SECRET=please-change-me
AUTH_ACCESS_TOKEN_HOURS=8

# --- PostgreSQL（如生产库不同请修改）---
DATABASE_URL=postgresql+psycopg://esb:esb@10.80.86.93:5432/cdb

# --- 抓取 / 探活 ---
PROBE_TIMEOUT_SECONDS=8
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=2000000
CRAWL_STORAGE_DIR=/home/aidoc/cacch-ai-platform/data/crawl
CRAWL_MAX_LIST_PAGES=20
CRAWL_MAX_ATTACHMENTS=50
CRAWL_OPEN_EFSA_PAGE_SIZE=20
CRAWL_OPEN_EFSA_MAX_PAGES=5
CRAWL_OPEN_EFSA_FETCH_DETAILS=true
CRAWL_OPEN_EFSA_MAX_DETAILS=20
CRAWL_OPEN_EFSA_DOWNLOAD_FILES=true

# --- CORS（同源部署一般用不到；多域名访问时逗号分隔）---
CORS_ORIGINS=http://10.80.85.85

# --- 业务 ---
DEFAULT_KB_NAME=默认知识库
APP_TIMEZONE=Asia/Shanghai

# --- 阿里云百炼 / 通义千问（OpenAI 兼容）---
LLM_PROVIDER=qwen
LLM_API_KEY=please-change-me
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# 可选降级
LLM_FALLBACK_PROFILE_ID=
LLM_FALLBACK_MODEL=

# --- Embedding（留空密钥则复用 LLM_API_KEY）---
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=2048
EMBEDDING_TIMEOUT_SECONDS=60
