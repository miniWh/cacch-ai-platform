API_AUTH_TOKEN=dev-token
# 用户 Access Token 签名密钥；留空则回退 API_AUTH_TOKEN
# AUTH_TOKEN_SECRET=
# AUTH_ACCESS_TOKEN_HOURS=8

# PostgreSQL（JDBC 对照）
# url: jdbc:postgresql://10.80.86.93:5432/cdb
# username: esb
# password: esb
# driver-class-name: org.postgresql.Driver
# 仅本机客户端查看时可在 JDBC URL 加 options=-c TimeZone=Asia/Shanghai（勿改库/角色默认时区）
DATABASE_URL=postgresql+psycopg://esb:esb@10.80.86.93:5432/cdb

PROBE_TIMEOUT_SECONDS=8
FETCH_TIMEOUT_SECONDS=20
# FETCH_MAX_BYTES=2000000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEFAULT_KB_NAME=默认知识库
APP_TIMEZONE=Asia/Shanghai

# --- 阿里云百炼 / 通义千问（OpenAI 兼容）---
LLM_PROVIDER=qwen
LLM_API_KEY=
# 业务空间专属或 DashScope 兼容地址（以控制台为准）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# 可选降级
# LLM_FALLBACK_PROFILE_ID=rag_chat_fast
# LLM_FALLBACK_MODEL=qwen-turbo

# Embedding（可留空密钥则复用 LLM_API_KEY；维度须与向量集合一致）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=2048
EMBEDDING_TIMEOUT_SECONDS=60
